void isectBranch(uint triIdx, vec3 rayOri, vec3 rayDir, uint baseOffset, inout uint localHitCnt){
	int k;
	float nd, f;
	float hu, hv;
	float lambda, mue;
//#ifdef USE_TRI_ACCEL
//	WaldTriangle acc = triAccList.acc[triIdx];
//	k = int(acc.n.w);
//	k1 = modulo[k+1];
//	k2 = modulo[k+2];
//
//	nd = 1.0f / (rayDir[k] + acc.n.x * rayDir[k1] + acc.n.y * rayDir[k2];
//	f = acc.n.z - (rayOri[k] + acc.n.x * rayOri[k1] + acc.n.y * rayOri[k2];
//	f = f * nd;
//
//	if(isnan(f) || f < EPSILON) return;
//
//	hu = rayOri[k1] + f * rayDir[k1];
//	hv = rayOri[k2] + f * rayDir[k2];
//
//	lambda = hu * acc.b.u + hv * acc.b.v + acc.b.z;
//	mue = hu * acc.c.u + hv * acc.c.v + acc.c.z;
//
//	if(lambda < 0.0f) return;
//	if(mue < 0.0f) return;
//	if((1.0f - lambda - mue) < 0.0f) return;
//
//	localHits[localHitCnt].t = f;
//	localHits[localHitCnt].triIndex = triIdx;
//	localHitCnt++;
//#else
	vec3 v0, v1, v2;

	uint startOffset = triIdx * 3 * VERTEX_SIZE;
	v0 = vec3(vertex.v[startOffset], vertex.v[startOffset+1],vertex.v[startOffset+2]);
	v1 = vec3(vertex.v[startOffset+VERTEX_SIZE], vertex.v[startOffset+VERTEX_SIZE + 1],vertex.v[startOffset+VERTEX_SIZE + 2]);
	v2 = vec3(vertex.v[startOffset+VERTEX_SIZE * 2], vertex.v[startOffset+VERTEX_SIZE + 1],vertex.v[startOffset+VERTEX_SIZE + 2]);

	vec3 e1 = v1 - v0;
	vec3 e2 = v2 - v0;
	vec3 pvec = cross(rayDir, e2);
	float det = dot(e1, pvec);

	//ray is parallel to plane
	if(det < EPSILON && det > -EPSILON){
		return;
	}

	float invDet = 1.0f / det;
	vec3 tvec = rayOri - v0;
	float u = dot(tvec, pvec) * invDet;
	if(u < 0.0f || u > 1.0f){
		return;
	}

	vec3 qvec = cross(tvec, e1);
	float v = dot(rayDir, qvec) * invDet;
	if(v < 0.0f || u + v > 1.0f){
		return;
	}

	f = dot(e2, qvec) * invDet;
	if(f < EPSILON) return;


	hitRecords.hr[baseOffset + localHitCnt].t = f;
	hitRecords.hr[baseOffset + localHitCnt].triIndex = triIdx;
//	localHits[localHitCnt].t = f;
//	localHits[localHitCnt].triIndex = triIdx;
	localHitCnt++;
//#endif
}

#if SORTING_ALGORITHM == 0
//insertion sort
void sortHits(uint baseOffset, uint count) {
    for (int i = 1; i < count; i++) {
        HitRecord key = hitRecords.hr[baseOffset + i];
        int j = i - 1;
        while (j >= 0 && hitRecords.hr[baseOffset + j].t > key.t) {
            hitRecords.hr[baseOffset + j + 1] = hitRecords.hr[baseOffset + j];
            j = j - 1;
        }
        hitRecords.hr[baseOffset + j + 1] = key;
    }
}
#elif SORTING_ALGORITHM == 1
//selection sort
void sortHits(uint baseOffset, uint count) {
    for (uint i = 0; i < count - 1; i++) {
        uint minIdx = i;
        for (uint j = i + 1; j < count; j++) {
            if (hitRecords.hr[baseOffset + j].t < hitRecords.hr[baseOffset + minIdx].t) {
                minIdx = j;
            }
        }

        if (minIdx != i) {
            HitRecord temp = hitRecords.hr[baseOffset + i];
            hitRecords.hr[baseOffset + i] = hitRecords.hr[baseOffset + minIdx];
            hitRecords.hr[baseOffset + minIdx] = temp;
        }
    }
}
#elif SORTING_ALGORITHM == 2
//merge sort
void sortHits(uint baseOffset, uint count) {
    if (count <= 1u || count > MAX_HITS) return;

    HitRecord temp[MAX_TRI_PER_LEAF];

    for (uint currSize = 1u; currSize < count; currSize = 2u * currSize) {
        for (uint leftStart = 0u; leftStart < count - 1u; leftStart += 2u * currSize) {
            
            uint mid = leftStart + currSize - 1u;
            uint rightEnd = min(leftStart + 2u * currSize - 1u, count - 1u);

            if (mid >= rightEnd) continue;

            uint i = leftStart;
            uint j = mid + 1u;
            uint k = leftStart;

            while (i <= mid && j <= rightEnd) {
                if (hitRecords.hr[baseOffset + i].t <= hitRecords.hr[baseOffset + j].t) {
                    temp[k] = hitRecords.hr[baseOffset + i];
                    i++;
                } else {
                    temp[k] = hitRecords.hr[baseOffset + j];
                    j++;
                }
                k++;
            }
            while (i <= mid) {
                temp[k] = hitRecords.hr[baseOffset + i];
                i++; k++;
            }
            while (j <= rightEnd) {
                temp[k] = hitRecords.hr[baseOffset + j];
                j++; k++;
            }
            for (uint x = leftStart; x <= rightEnd; x++) {
                hitRecords.hr[baseOffset + x] = temp[x];
            }
        }
    }
}
#elif SORTING_ALGORITHM == 3
//heap sort
void siftDown(uint baseOffset, uint start, uint end) {
    uint root = start;

    while (root * 2u + 1u <= end) {
        uint child = root * 2u + 1u;
        uint swapIdx = root;

        if (hitRecords.hr[baseOffset + swapIdx].t < hitRecords.hr[baseOffset + child].t) {
            swapIdx = child;
        }
        if (child + 1u <= end && hitRecords.hr[baseOffset + swapIdx].t < hitRecords.hr[baseOffset + child + 1u].t) {
            swapIdx = child + 1u;
        }

        if (swapIdx == root) {
            return;
        } else {
            HitRecord temp = hitRecords.hr[baseOffset + root];
            hitRecords.hr[baseOffset + root] = hitRecords.hr[baseOffset + swapIdx];
            hitRecords.hr[baseOffset + swapIdx] = temp;
            root = swapIdx;
        }
    }
}

void sortHits(uint baseOffset, uint count) {
    if (count <= 1u) return;

    for (int i = int(count / 2u) - 1; i >= 0; i--) {
        siftDown(baseOffset, uint(i), count - 1u);
    }

    for (uint i = count - 1u; i > 0u; i--) {
        HitRecord temp = hitRecords.hr[baseOffset + 0];
        hitRecords.hr[baseOffset + 0] = hitRecords.hr[baseOffset + i];
        hitRecords.hr[baseOffset + i] = temp;

        siftDown(baseOffset, 0u, i - 1u);
    }
}
#endif

